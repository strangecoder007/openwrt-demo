#!/bin/sh
# WiFi Probe - UCI defaults (conservative): enable service only.
# Do NOT touch wireless: mon0 is created manually (iw) to avoid netifd/mac80211
# rebuilding the radio, which can disrupt the client connection.

uci -q set wifi-probe.main.enabled='1'
uci -q commit wifi-probe
rm -f /tmp/luci-indexcache
exit 0
