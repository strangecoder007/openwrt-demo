#!/bin/sh /etc/rc.common
# App Traffic Analyzer init script
# Copyright (C) 2024

START=85
STOP=15
USE_PROCD=1

PROG=/usr/sbin/apptraffic

start_service() {
    local interface database commit_interval dns_timeout retention_days enabled

    config_load apptraffic
    config_get enabled apptraffic enabled "1"
    config_get interface apptraffic interface "br-lan"
    config_get database apptraffic database "/var/lib/apptraffic"
    config_get commit_interval apptraffic commit_interval "60"
    config_get dns_timeout apptraffic dns_timeout "3600"
    config_get retention_days apptraffic retention_days "30"

    [ "$enabled" != "1" ] && return 0

    # Ensure database directory exists
    mkdir -p "$database"

    procd_open_instance
    procd_set_param command "$PROG" -d \
        -i "$interface" \
        -D "$database" \
        -C "$commit_interval" \
        -I "$dns_timeout" \
        -R "$retention_days"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    service_stop "$PROG"
}

service_triggers() {
    procd_add_reload_trigger "apptraffic"
}
