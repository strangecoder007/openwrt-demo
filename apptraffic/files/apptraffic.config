# App Traffic Analyzer configuration

config apptraffic
    # Enable/disable the daemon (1=enabled, 0=disabled)
    option enabled '1'

    # Interface to capture traffic on (e.g., br-lan, eth0, any)
    option interface 'br-lan'

    # Database storage directory
    option database '/var/lib/apptraffic'

    # Commit interval in seconds (how often data is written to disk)
    option commit_interval '60'

    # DNS cache timeout in seconds (how long IP-domain mappings are kept)
    option dns_timeout '3600'
