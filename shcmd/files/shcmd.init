#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/shcmd -f -c /etc/shcmd.conf
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1

	# Do NOT clamp nofile here.
	#
	# An earlier version set limits nofile="64 64" to keep the daemon light.
	# That silently broke every service restart issued through shcmd:
	# /lib/functions/procd.sh takes a lock on file descriptor 1000
	# (`flock -n 1000`, then `exec 1000>...`), and a child of this daemon
	# inherits the 64-descriptor cap, so opening fd 1000 fails with
	#     /etc/rc.common: /lib/functions/procd.sh: line 54: 3: Bad file
	#     descriptor
	# and `/etc/init.d/<svc> restart` exits 1 without doing anything.
	#
	# The same command from an ssh shell worked because there the limit is
	# 1024. So the symptom looked like "restart via shcmd never works" while
	# nothing was wrong with the command itself.
	#
	# The daemon needs at most a handful of descriptors (listen socket, one
	# client, two pipe ends), so the default limit is perfectly safe.
	procd_close_instance
}
