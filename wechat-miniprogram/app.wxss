page {
  background: #f7f8fa;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.4;
}

button {
  font-size: 28rpx;
  margin: 0;
  padding: 0 24rpx;
  line-height: 2.6;
}

button::after { border: none; }

.page {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 35, 41, 0.05);
}

.btn-primary {
  background: #06ad56;
  color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(6, 173, 86, 0.25);
}

.btn-primary[disabled] { background: #bfe5d0; color: #fff; box-shadow: none; }
.btn-primary.big { height: 96rpx; line-height: 96rpx; font-size: 32rpx; font-weight: 600; letter-spacing: 4rpx; }

.btn-outline {
  background: #fff;
  color: #06ad56;
  border: 2rpx solid #06ad56;
  border-radius: 20rpx;
}

.btn-outline[disabled] { color: #bfe5d0; border-color: #d8efe3; background: #f7fbf9; }

.btn-ghost {
  background: #f2f3f5;
  color: #4e5969;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.btn-danger {
  background: #fa5151;
  color: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.btn-danger[disabled] { background: #f5b8b8; color: #fff; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 8rpx 20rpx;
}

.empty { text-align: center; color: #9aa0a6; margin-top: 160rpx; }
.empty-icon { font-size: 88rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 26rpx; }

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #06ad56, #0b9a6c);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(6, 173, 86, 0.35);
  z-index: 10;
}

.fab-plus { font-size: 60rpx; line-height: 1; }
