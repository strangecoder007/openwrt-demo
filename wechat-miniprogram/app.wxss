page {
  background: #f6f7f9;
  font-size: 28rpx;
  color: #1f2329;
}

button {
  font-size: 28rpx;
  margin: 0;
  padding: 0 24rpx;
  line-height: 2.5;
}

button::after { border: none; }

.page {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.06);
}

.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 16rpx;
}

.btn-primary[disabled] { background: #b9e6cd; color: #fff; }
.btn-primary.big { height: 88rpx; line-height: 88rpx; font-size: 30rpx; }

.btn-outline {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 16rpx;
}

.btn-outline[disabled] { color: #b9e6cd; border-color: #d8efe3; background: #f7fbf9; }

.btn-ghost {
  background: #f2f3f5;
  color: #4e5969;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.btn-danger {
  background: #fa5151;
  color: #fff;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.btn-danger[disabled] { background: #f5b8b8; color: #fff; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 8rpx 20rpx;
}

.empty { text-align: center; color: #9aa0a6; margin-top: 160rpx; }
.empty-icon { font-size: 88rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 26rpx; }

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(7, 193, 96, 0.4);
  z-index: 10;
}

.fab-plus { font-size: 60rpx; line-height: 1; }
