<view class="page">
  <view class="section-title">选择文件</view>
  <view class="btn-row">
    <button class="btn-outline pick-btn" bindtap="pickImage" disabled="{{uploading}}">
      <text class="pick-emoji">📷</text>
      <text class="pick-title">选照片</text>
      <text class="pick-hint">最多 9 张</text>
    </button>
    <button class="btn-outline pick-btn" bindtap="pickVideo" disabled="{{uploading}}">
      <text class="pick-emoji">🎬</text>
      <text class="pick-title">选视频</text>
      <text class="pick-hint">≤500MB</text>
    </button>
  </view>

  <view class="card" wx:if="{{files.length}}">
    <view class="file-row" wx:for="{{files}}" wx:key="index">
      <view class="file-icon {{item.type}}">{{item.type === 'video' ? '🎬' : '🖼'}}</view>
      <view class="file-info">
        <view class="file-name">{{index + 1}}. {{item.type === 'video' ? '视频' : '图片'}}</view>
        <view class="file-size">{{item.sizeLabel}}</view>
      </view>
      <view class="file-status {{item.status}}">
        <block wx:if="{{item.status === 'done'}}">✓ 完成</block>
        <block wx:elif="{{item.status === 'uploading'}}">上传中 {{item.percent}}%</block>
        <block wx:else>待上传</block>
      </view>
      <view class="file-remove" bindtap="removeFile" data-index="{{index}}">×</view>
    </view>
  </view>

  <view class="card progress-card" wx:if="{{uploading}}">
    <view class="progress-head">
      <text class="progress-label">总进度</text>
      <text class="progress-pct">{{percent}}%</text>
    </view>
  <!-- 不能用 active：它会在每次 percent 更新时从 0 重播动画，总条看起来一直从头开始 -->
  <progress percent="{{percent}}" stroke-width="12" activeColor="#06ad56" backgroundColor="#eef0f2" borderRadius="6" />
    <view class="progress-sub">{{done}}/{{total}} · {{currentName}}（{{filePercent}}%）</view>
  </view>

  <button class="btn-primary big" bindtap="startUpload" disabled="{{uploading || files.length === 0}}">开始上传</button>
  <view class="version">云盘 {{version}}</view>
</view>
