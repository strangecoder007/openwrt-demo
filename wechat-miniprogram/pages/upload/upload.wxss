.upload-page { display: flex; flex-direction: column; }
.section-title { margin: 12rpx 8rpx 30rpx; }

/* —— 选择卡：大留白 + 线性图标 + 按压微动效 —— */
.btn-row { display: flex; margin: 6rpx 0 44rpx; }
.pick-btn {
  flex: 1;
  height: 200rpx;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 2rpx solid var(--line-strong);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-1);
}
.btn-row .pick-btn + .pick-btn { margin-left: 24rpx; }
.pick-btn[disabled] { opacity: 0.55; }
.pick-icon { width: 56rpx; height: 56rpx; margin-bottom: 14rpx; }
.pick-title { font-size: 28rpx; font-weight: 600; color: var(--brand-ink); letter-spacing: 1rpx; }
.pick-hint { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; }

/* —— 待传列表 —— */
.file-row { display: flex; align-items: center; padding: 24rpx 0; }
.file-row + .file-row { border-top: 1rpx solid var(--line); }
.file-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.file-icon.image { background: var(--ok-tint); }
.file-icon.video { background: var(--accent-tint); }
/* 有真实缩略图时铺满图标位（圆角裁剪），点一下可本地预览 */
.file-icon { overflow: hidden; }
.fi-thumb { width: 100%; height: 100%; display: block; }
.fi-img { width: 40rpx; height: 40rpx; }
.file-info { flex: 1; min-width: 0; }
.file-name { font-size: 27rpx; color: var(--ink); font-weight: 600; }
.file-size { font-size: 22rpx; color: var(--ink-3); margin-top: 6rpx; font-feature-settings: "tnum"; }

/* 状态胶囊：带指示点 */
.file-status {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  margin-right: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface-3);
  color: var(--ink-2);
  line-height: 1.2;
  flex-shrink: 0;
}
.file-status::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: var(--ink-3);
}
.file-status.pending { color: var(--ink-3); }
.file-status.pending::before { background: var(--dot-idle); }
.file-status.uploading { color: var(--accent-ink); background: var(--accent-tint); }
.file-status.uploading::before { background: var(--accent); }
.file-status.done { color: var(--ok); background: var(--ok-tint); }
.file-status.done::before { background: var(--ok); }
.file-status.fail { color: var(--danger); background: var(--danger-tint); }
.file-status.fail::before { background: var(--danger); }
.file-remove {
  font-size: 44rpx;
  color: var(--ink-3);
  padding: 0 4rpx 0 12rpx;
  font-weight: 300;
  line-height: 1;
  flex-shrink: 0;
}

/* —— 进度卡：大数字 + 细轨道 —— */
.progress-card { margin-top: 8rpx; }
.progress-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20rpx; }
.progress-label { font-size: 24rpx; color: var(--ink-2); letter-spacing: 2rpx; }
.progress-pct { font-size: 28rpx; font-weight: 700; color: var(--accent-ink); }
.pct-num { font-size: 52rpx; font-feature-settings: "tnum"; }
.pct-unit { font-size: 26rpx; margin-left: 2rpx; }
.progress-track {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--surface-3);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--accent-lite), var(--accent));
  transition: width var(--t-mid) var(--ease);
}
.progress-sub { font-size: 22rpx; color: var(--ink-3); margin-top: 16rpx; word-break: break-all; }

.version {
  margin-top: auto;
  padding-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  opacity: 0.55;
  letter-spacing: 2rpx;
}
