.home-page { padding: 0 0 160rpx; }
.hero {
  position: relative;
  margin: -24rpx -24rpx 0;
  padding: 56rpx 40rpx 64rpx;
  background: linear-gradient(150deg, #06ad56 0%, #0b9a6c 100%);
  border-radius: 0 0 44rpx 44rpx;
  color: #fff;
  overflow: hidden;
}
.hero-cloud {
  position: absolute;
  right: -30rpx;
  top: 30rpx;
  font-size: 200rpx;
  opacity: 0.14;
  transform: rotate(-8deg);
}
.hero-title { font-size: 46rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-sub { font-size: 25rpx; color: rgba(255, 255, 255, 0.88); margin-top: 12rpx; }
.month-list { padding: 28rpx 24rpx 0; }
.month-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 35, 41, 0.05);
}
.month-card.press { opacity: 0.85; }
.month-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
}
.month-icon.c0 { background: #e6f7ee; }
.month-icon.c1 { background: #e8f1ff; }
.month-icon.c2 { background: #fff3e0; }
.month-icon.c3 { background: #f3e8ff; }
.month-info { flex: 1; }
.month-name { font-size: 32rpx; font-weight: 600; color: #1f2329; }
.month-count { font-size: 24rpx; color: #9aa0a6; margin-top: 6rpx; }
.month-arrow {
  font-size: 40rpx;
  color: #06ad56;
  opacity: 0.55;
  font-weight: 300;
}
