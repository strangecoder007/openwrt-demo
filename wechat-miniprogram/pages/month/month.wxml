<view class="page">
  <view wx:for="{{days}}" wx:key="key" class="day-section">
    <view class="day-header">
      <text class="day-label">{{item.label}}</text>
      <text class="day-count">{{item.files.length}} 个</text>
    </view>
    <view class="grid">
      <view wx:for="{{item.files}}" wx:for-item="file" wx:key="name" class="cell {{editing ? 'editing' : ''}}" data-path="{{file.path}}" bindtap="onTapFile" hover-class="press">
        <image wx:if="{{file.thumb}}" src="{{file.thumb}}" mode="aspectFill" class="thumb" />
        <view wx:else class="thumb placeholder {{file.type === 'video' ? 'video' : ''}}">
          <block wx:if="{{file.type === 'video'}}">
            <view class="video-play">▶</view>
            <text class="video-name">{{file.name}}</text>
          </block>
          <view wx:else class="err-text">{{file.status === 'error' ? (file.error || '加载失败') : '加载中…'}}</view>
        </view>
        <view wx:if="{{file.type === 'video' && file.thumb}}" class="video-badge">▶</view>
        <view wx:if="{{editing}}" class="check {{selected[file.path] ? 'checked' : ''}}">✓</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!days.length}}" class="empty">
    <view class="empty-icon">📂</view>
    <view class="empty-text">这个月还没有文件</view>
  </view>

  <view class="edit-bar" wx:if="{{editing}}">
    <text class="edit-count">已选 {{selectedCount}} 项</text>
    <button class="btn-outline mini" disabled="{{selectedCount === 0}}" bindtap="onDownloadSelected">下载({{selectedCount}})</button>
    <button class="btn-danger" disabled="{{selectedCount === 0}}" bindtap="onDeleteSelected">删除({{selectedCount}})</button>
    <button class="btn-ghost" bindtap="onToggleEdit">完成</button>
  </view>
  <button wx:if="{{days.length && !editing}}" class="btn-primary edit-fab" bindtap="onToggleEdit">编辑</button>
</view>

<view wx:if="{{videoSrc}}" class="video-overlay" bindtap="closeVideo">
  <video src="{{videoSrc}}" controls class="video-player" catchtap="noop" />
  <view class="video-close" catchtap="closeVideo">×</view>
</view>
