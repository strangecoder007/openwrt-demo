.day-section { margin-bottom: 32rpx; }
.day-header {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #4e5969;
  margin: 8rpx 8rpx 18rpx;
}
.day-header::before {
  content: '';
  width: 8rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background: #06ad56;
  margin-right: 12rpx;
}
.day-label { font-size: 28rpx; }
.day-count {
  margin-left: 14rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #9aa0a6;
  background: #eef0f2;
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}
.grid { display: flex; flex-wrap: wrap; padding: 0 0 16rpx; }
.cell {
  position: relative;
  width: 31.5%;
  margin: 1% 0.75%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.07);
}
.cell.press { opacity: 0.8; }
.thumb { width: 100%; height: 210rpx; display: block; }
.thumb.placeholder {
  height: 210rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #9aa0a6;
  background: linear-gradient(180deg, #fafbfc, #eef0f2);
  padding: 8rpx;
  box-sizing: border-box;
}
.thumb.placeholder.video { color: #f5a623; }
.err-text {
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}
.video-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.video-play {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fff4e0;
  color: #f5a623;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.video-name { word-break: break-all; text-align: center; max-height: 56rpx; overflow: hidden; }
.check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  color: #bbb;
  font-size: 26rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.12);
}
.check.checked { background: #06ad56; color: #fff; border-color: #06ad56; }
.edit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(31, 35, 41, 0.08);
}
.edit-count { flex: 1; font-size: 26rpx; color: #1f2329; }
.edit-bar button { margin-left: 16rpx; font-size: 24rpx; padding: 0 20rpx; line-height: 2.4; }
.edit-bar .btn-outline.mini { color: #06ad56; }
.edit-bar .btn-danger { margin-right: 16rpx; }
.edit-fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  line-height: 120rpx;
  padding: 0;
  font-size: 28rpx;
  background: linear-gradient(135deg, #06ad56, #0b9a6c);
  box-shadow: 0 12rpx 32rpx rgba(6, 173, 86, 0.35);
  z-index: 10;
}
.video-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}
.video-player { width: 100%; height: 100%; }
.video-close {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 44rpx;
  line-height: 64rpx;
  text-align: center;
  z-index: 10;
}
