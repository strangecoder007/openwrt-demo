.grid { display: flex; flex-wrap: wrap; padding: 8rpx 0 140rpx; }
.cell {
  position: relative;
  width: 31.5%;
  margin: 1% 0.75%;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.08);
}
.cell.press { opacity: 0.8; }
.thumb { width: 100%; height: 200rpx; display: block; }
.thumb.placeholder {
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #9aa0a6;
  background: linear-gradient(180deg, #f7f8fa, #eef0f2);
  padding: 8rpx;
  box-sizing: border-box;
}
.thumb.placeholder.video { color: #07c160; }
.video-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.video-play {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(7, 193, 96, 0.15);
  color: #07c160;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.video-name { word-break: break-all; text-align: center; max-height: 56rpx; overflow: hidden; }
.check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  color: #bbb;
  font-size: 26rpx;
  border: 2rpx solid #d0d3d6;
}
.check.checked { background: #07c160; color: #fff; border-color: #07c160; }
.edit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(31, 35, 41, 0.08);
}
.edit-count { flex: 1; font-size: 26rpx; color: #1f2329; }
.edit-bar button { margin-left: 16rpx; font-size: 24rpx; padding: 0 20rpx; line-height: 2.4; }
.edit-bar .btn-outline.mini { color: #07c160; }
.edit-bar .btn-danger { margin-right: 16rpx; }
.edit-fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  line-height: 120rpx;
  padding: 0;
  font-size: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(7, 193, 96, 0.4);
  z-index: 10;
}
.video-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}
.video-player { width: 100%; height: 100%; }
.video-close {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 44rpx;
  line-height: 64rpx;
  text-align: center;
  z-index: 10;
}
