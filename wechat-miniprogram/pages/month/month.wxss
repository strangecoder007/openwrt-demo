.grid { display: flex; flex-wrap: wrap; padding: 20rpx; }
.cell { width: 31%; margin: 1%; background: #fff; border-radius: 8rpx; overflow: hidden; }
.thumb-placeholder { height: 180rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #666; word-break: break-all; padding: 8rpx; box-sizing: border-box; }
.thumb-placeholder.video { color: #07c160; }
.video-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: #000; z-index: 99; }
