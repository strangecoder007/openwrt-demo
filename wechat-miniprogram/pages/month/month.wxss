.grid { display: flex; flex-wrap: wrap; padding: 20rpx 20rpx 140rpx; }
.cell { position: relative; width: 31%; margin: 1%; background: #f2f2f2; border-radius: 8rpx; overflow: hidden; }
.thumb { width: 100%; height: 200rpx; }
.thumb.placeholder { height: 200rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 20rpx; color: #666; padding: 8rpx; box-sizing: border-box; }
.thumb.placeholder.video { color: #07c160; }
.play-icon { font-size: 40rpx; margin-bottom: 6rpx; }
.video-name { word-break: break-all; text-align: center; }
.check { position: absolute; top: 8rpx; right: 8rpx; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 50%; background: rgba(255,255,255,0.9); color: #bbb; font-size: 26rpx; border: 2rpx solid #ccc; }
.check.checked { background: #07c160; color: #fff; border-color: #07c160; }
.edit-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; padding: 20rpx; background: #fff; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06); }
.edit-count { flex: 1; font-size: 26rpx; color: #333; }
.btn-edit { margin: 0 12rpx; background: #07c160; color: #fff; border-radius: 8rpx; font-size: 26rpx; }
.btn-edit[disabled] { background: #ccc; color: #fff; }
.video-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: #000; z-index: 99; }
