.login-page { padding: 0 32rpx 56rpx; min-height: 100vh; box-sizing: border-box; }

/* —— Hero —— */
.hero {
  margin: -32rpx -32rpx 0;
  background:
    radial-gradient(120% 90% at 85% -10%, var(--hero-glow) 0%, transparent 55%),
    linear-gradient(165deg, var(--hero-1) 0%, var(--brand) 48%, var(--brand-deep) 100%);
  border-radius: 0 0 40rpx 40rpx;
  color: var(--on-brand);
  padding: 0 0 72rpx;
}
.hero-body { padding: 72rpx 40rpx 0; text-align: center; }
.logo-ring {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 28rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.18);
}
.logo-img { width: 64rpx; height: 64rpx; }
.eyebrow {
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: var(--on-brand-dim);
  margin-bottom: 12rpx;
}
.title { font-size: 48rpx; font-weight: 700; letter-spacing: 3rpx; }
.subtitle { font-size: 24rpx; color: var(--on-brand-soft); margin-top: 14rpx; letter-spacing: 1rpx; }

/* —— 表单卡：压在 hero 上，更浮起 —— */
.form-card { margin: -44rpx 0 0; padding: 40rpx 34rpx 34rpx; position: relative; z-index: 1; }
.field-group { margin-bottom: 32rpx; }
.field-label {
  font-size: 22rpx;
  color: var(--ink-2);
  display: block;
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
}
.field {
  background: var(--surface-2);
  border: 2rpx solid transparent;
  border-radius: var(--r-md);
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  transition: border-color var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease);
}
/* placeholder-class 作用在占位符自身，不要写成 .field.ph */
.ph { color: var(--ink-3); }

.remember-row {
  display: flex;
  align-items: center;
  margin: -4rpx 0 34rpx;
}
.remember-label {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: var(--ink-2);
}
.remember-label checkbox {
  transform: scale(0.85);
  margin-right: 4rpx;
}

.register-link {
  text-align: center;
  font-size: 26rpx;
  color: var(--brand-ink);
  margin-top: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  transition: opacity var(--t-fast) var(--ease);
}
.link-press { opacity: 0.6; }

.version {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 48rpx;
  letter-spacing: 2rpx;
  opacity: 0.7;
}
