.login-page { padding: 0 24rpx 48rpx; min-height: 100vh; }
.hero {
  margin: -24rpx -24rpx 0;
  background: linear-gradient(168deg, #1c3d3a 0%, #2c4f4b 100%);
  border-radius: 0 0 30rpx 30rpx;
  color: #fff;
  padding: 0 0 64rpx;
}
.hero-body { padding: 64rpx 32rpx 0; text-align: center; }
.logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.title { font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; }
.subtitle { font-size: 24rpx; color: rgba(255, 255, 255, 0.72); margin-top: 12rpx; }
.card { margin: -38rpx 0 0; padding: 34rpx 30rpx 30rpx; position: relative; z-index: 1; }
.field-group { margin-bottom: 30rpx; }
.field-label { font-size: 22rpx; color: #7c9a92; display: block; margin-bottom: 10rpx; letter-spacing: 1rpx; }
.field {
  background: #f2f5f3;
  border: 1rpx solid #e3eae6;
  border-radius: 10rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
}
.remember-row {
  display: flex;
  align-items: center;
  margin: -2rpx 0 30rpx;
}
.remember-label {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: #5b6f6b;
}
.remember-label checkbox {
  transform: scale(0.85);
  margin-right: 4rpx;
}
.register-link { text-align: center; font-size: 26rpx; color: #1c3d3a; margin-top: 26rpx; font-weight: 500; }
.register-link:active { opacity: 0.7; }
.version {
  text-align: center;
  font-size: 22rpx;
  color: #aab9b4;
  margin-top: 40rpx;
}
