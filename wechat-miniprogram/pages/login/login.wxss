.page { display: flex; flex-direction: column; justify-content: center; min-height: 90vh; padding: 60rpx 48rpx; }
.brand { text-align: center; margin-bottom: 56rpx; }
.logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: #e8f8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.title { font-size: 40rpx; font-weight: 700; }
.subtitle { font-size: 24rpx; color: #9aa0a6; margin-top: 10rpx; }
.field-group { margin-bottom: 32rpx; }
.field-label { font-size: 24rpx; color: #9aa0a6; display: block; margin-bottom: 12rpx; }
.field {
  background: #f6f7f9;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
}
.remember-row {
  display: flex;
  align-items: center;
  margin: -8rpx 0 28rpx;
}
.remember-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}
.remember-label checkbox {
  transform: scale(0.85);
  margin-right: 4rpx;
}
.register-link { text-align: center; font-size: 26rpx; color: #07c160; margin-top: 24rpx; }
.version { text-align: center; font-size: 22rpx; color: #c4c9cd; margin-top: 48rpx; }
