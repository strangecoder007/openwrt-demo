.login-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx 48rpx;
  position: relative;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  top: -240rpx;
  left: -180rpx;
  right: -180rpx;
  height: 640rpx;
  background: linear-gradient(160deg, #d8f5e6 0%, #eafaf3 45%, rgba(234, 250, 243, 0) 100%);
  border-radius: 0 0 50% 50%;
  z-index: 0;
}
.brand {
  position: relative;
  z-index: 1;
  text-align: center;
  margin-bottom: 48rpx;
}
.logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #d9f6e8, #b8ebd3);
  box-shadow: 0 12rpx 28rpx rgba(6, 173, 86, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
}
.title { font-size: 40rpx; font-weight: 700; }
.subtitle { font-size: 24rpx; color: #9aa0a6; margin-top: 10rpx; }
.card { position: relative; z-index: 1; padding: 36rpx 32rpx 32rpx; }
.field-group { margin-bottom: 32rpx; }
.field-label { font-size: 24rpx; color: #9aa0a6; display: block; margin-bottom: 12rpx; }
.field {
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  font-size: 28rpx;
}
.remember-row {
  display: flex;
  align-items: center;
  margin: -4rpx 0 32rpx;
}
.remember-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}
.remember-label checkbox {
  transform: scale(0.85);
  margin-right: 4rpx;
}
.register-link { text-align: center; font-size: 26rpx; color: #06ad56; margin-top: 28rpx; }
.register-link:active { opacity: 0.7; }
.version {
  position: relative;
  z-index: 1;
  text-align: center;
  font-size: 22rpx;
  color: #c4c9cd;
  margin-top: 48rpx;
}
