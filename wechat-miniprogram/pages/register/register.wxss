.register-page { padding: 0 32rpx 96rpx; box-sizing: border-box; }

/* —— Hero（与登录页同构） —— */
.hero {
  margin: -32rpx -32rpx 0;
  background:
    radial-gradient(120% 90% at 85% -10%, var(--hero-glow) 0%, transparent 55%),
    linear-gradient(165deg, var(--hero-1) 0%, var(--brand) 48%, var(--brand-deep) 100%);
  border-radius: 0 0 40rpx 40rpx;
  color: var(--on-brand);
  padding: 0 0 68rpx;
}
.hero-body { padding: 64rpx 40rpx 0; text-align: center; }
.logo-ring {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 28rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.18);
}
.logo-img { width: 64rpx; height: 64rpx; }
.eyebrow {
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: var(--on-brand-dim);
  margin-bottom: 12rpx;
}
.title { font-size: 48rpx; font-weight: 700; letter-spacing: 3rpx; }
.subtitle { font-size: 24rpx; color: var(--on-brand-soft); margin-top: 14rpx; letter-spacing: 1rpx; }

/* —— 表单卡 —— */
.register-card { margin: -44rpx 0 0; padding: 40rpx 34rpx 32rpx; position: relative; z-index: 1; }
.field-group { margin-bottom: 30rpx; }
.field-label {
  font-size: 22rpx;
  color: var(--ink-2);
  display: block;
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
}
.field {
  background: var(--surface-2);
  border: 2rpx solid transparent;
  border-radius: var(--r-md);
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  transition: border-color var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease);
}
/* placeholder-class 作用在占位符自身，不要写成 .field.ph */
.ph { color: var(--ink-3); }

/* 分隔：居中文字压在发丝线上 */
.divider {
  position: relative;
  height: 2rpx;
  background: var(--line);
  margin: 12rpx 0 34rpx;
}
.divider-text {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: var(--surface);
  padding: 0 24rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

.btn-primary { margin-top: 16rpx; }
.tip {
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 30rpx;
  line-height: 1.8;
  letter-spacing: 1rpx;
}
