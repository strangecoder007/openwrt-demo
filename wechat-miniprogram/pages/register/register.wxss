.register-page {
  padding: 60rpx 48rpx 80rpx;
  position: relative;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  top: -240rpx;
  left: -180rpx;
  right: -180rpx;
  height: 640rpx;
  background: linear-gradient(160deg, #d8f5e6 0%, #eafaf3 45%, rgba(234, 250, 243, 0) 100%);
  border-radius: 0 0 50% 50%;
  z-index: 0;
}
.brand { position: relative; z-index: 1; text-align: center; margin-bottom: 40rpx; }
.logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #d9f6e8, #b8ebd3);
  box-shadow: 0 12rpx 28rpx rgba(6, 173, 86, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
}
.title { font-size: 40rpx; font-weight: 700; }
.subtitle { font-size: 24rpx; color: #9aa0a6; margin-top: 10rpx; }
.register-card { position: relative; z-index: 1; padding: 36rpx 32rpx 28rpx; }
.field-group { margin-bottom: 28rpx; }
.field-label { font-size: 24rpx; color: #9aa0a6; display: block; margin-bottom: 12rpx; }
.field {
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  font-size: 28rpx;
}
.divider { height: 2rpx; background: #f0f1f3; margin: 8rpx 0 32rpx; }
.btn-primary { margin-top: 12rpx; }
.btn-primary[disabled] { background: #bfe5d0; color: #fff; box-shadow: none; }
.tip { font-size: 22rpx; color: #c4c9cd; text-align: center; margin-top: 28rpx; line-height: 1.7; }
