<view class="page register-page">
  <view class="hero">
    <view class="film-strip"></view>
    <view class="hero-body">
      <view class="logo">🔑</view>
      <view class="title">注册账号</view>
      <view class="subtitle">新账号与管理员共用同一个云盘</view>
    </view>
  </view>

  <view class="card register-card">
    <view class="field-group">
      <text class="field-label">服务器地址</text>
      <input class="field" placeholder="https://cy.gcaiyy.xyz:34443" value="{{baseUrl}}" data-field="baseUrl" bindinput="onInput" />
    </view>
    <view class="field-group">
      <text class="field-label">管理员账号</text>
      <input class="field" placeholder="backup" value="{{adminUser}}" data-field="adminUser" bindinput="onInput" />
    </view>
    <view class="field-group">
      <text class="field-label">管理员密码（用于开通新账号）</text>
      <input class="field" placeholder="请输入管理员密码" password value="{{adminPass}}" data-field="adminPass" bindinput="onInput" />
    </view>
    <view class="divider"></view>
    <view class="field-group">
      <text class="field-label">新用户名（3-32 位字母数字）</text>
      <input class="field" placeholder="例如 family" value="{{newUser}}" data-field="newUser" bindinput="onInput" />
    </view>
    <view class="field-group">
      <text class="field-label">新密码（至少 6 位）</text>
      <input class="field" placeholder="请输入密码" password value="{{newPass}}" data-field="newPass" bindinput="onInput" />
    </view>
    <view class="field-group">
      <text class="field-label">确认新密码</text>
      <input class="field" placeholder="再输一次" password value="{{newPass2}}" data-field="newPass2" bindinput="onInput" />
    </view>
    <button class="btn-primary big" bindtap="onSubmit" disabled="{{loading}}">{{loading ? '注册中…' : '注 册'}}</button>
    <view class="tip">注册需要管理员密码；新账号登录后可查看、上传、删除云盘文件。</view>
  </view>
</view>
