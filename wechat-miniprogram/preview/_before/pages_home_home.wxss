.home-page { padding: 0 0 160rpx; }
.hero {
  margin: -24rpx -24rpx 0;
  background: linear-gradient(160deg, #1c3d3a 0%, #2c4f4b 100%);
  border-radius: 0 0 30rpx 30rpx;
  color: #fff;
  padding: 0 0 56rpx;
}
.hero-body { padding: 48rpx 36rpx 0; }
.hero-title { font-size: 46rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.72); margin-top: 12rpx; }
.hero-rule { width: 72rpx; height: 6rpx; border-radius: 3rpx; background: #d9822b; margin-top: 24rpx; }
.month-list { padding: 26rpx 24rpx 0; }
.month-card {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1rpx solid #e3eae6;
  border-radius: 14rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 20rpx rgba(28, 61, 58, 0.05);
}
.month-card.press { opacity: 0.85; }
.month-accent { width: 8rpx; height: 64rpx; border-radius: 4rpx; background: #d9822b; margin-right: 22rpx; }
.month-info { flex: 1; }
.month-name { font-size: 38rpx; font-weight: 700; color: #1c3d3a; letter-spacing: 1rpx; }
.month-count { font-size: 22rpx; color: #7c9a92; margin-top: 6rpx; }
.month-arrow { font-size: 38rpx; color: #1c3d3a; opacity: 0.4; font-weight: 300; }
