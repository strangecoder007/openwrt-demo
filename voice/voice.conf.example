#!/bin/sh
# /etc/voice.conf —— 语音助手配置
#
# 权限必须是 600（含密钥）
#   chmod 600 /etc/voice.conf
#
# 这些变量由 /usr/bin/voicectl 读取并 export

# ===== 腾讯云 ASR / TTS（TC3 签名）=====
TENCENT_SECRET_ID="<your-secret-id>"
TENCENT_SECRET_KEY="<your-secret-key>"
TENCENT_APP_ID="<your-app-id>"
TENCENT_REGION="ap-shanghai"

ASR_BACKEND=tencent
TTS_BACKEND=tencent

# ===== 大模型（TokenHub，OpenAI 兼容）=====
LLM_BACKEND=openai
LLM_BASE_URL="https://tokenhub.tencentmaas.com/v1"
LLM_API_KEY="<your-api-key>"
LLM_MODEL="hunyuan-role-latest"
LLM_MAX_HISTORY=3


# ===== 唤醒触发（voice-trigger 服务用）=====
# 留空 = 不监听该触发源
# ASRPRO 串口接法：模块 TX -> 板子 RXD(ttymxc1)，模块 RX -> 板子 TXD，GND 共地
VOICE_TRIGGER_UART=""
VOICE_TRIGGER_BAUD=115200
VOICE_TRIGGER_KEYWORD="WAKE"

# GPIO 触发（sysfs 编号）；和 UART 可以同时启用
VOICE_TRIGGER_GPIO=""
VOICE_TRIGGER_GPIO_ACTIVE=1

VOICE_TRIGGER_DEBOUNCE=3000
VOICE_TRIGGER_ASK_SECS=15
VOICE_TRIGGER_VERBOSE=0

# ===== 录音方式 =====
# 1 = VAD（说话才录，说完即停，推荐）
# 0 = 固定时长（由 VOICE_RECORD_SECS 决定）
VOICE_VAD=1
VOICE_VAD_SILENCE=800
# 0 = 自适应底噪（推荐）；>0 = 固定起始阈值
VOICE_VAD_RMS=0

# ===== 交互默认参数 =====
# 每轮录音秒数
VOICE_RECORD_SECS=5
