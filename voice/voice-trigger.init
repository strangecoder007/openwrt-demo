#!/bin/sh /etc/rc.common
#
# voice-trigger —— 语音助手常驻唤醒监听
#
# 开机自启，监听 UART/GPIO 上的唤醒信号，触发一次完整对话。
#
# 配置在 /etc/voice.conf（和 voicectl 共用），额外支持：
#   VOICE_TRIGGER_UART=/dev/ttymxc1    监听串口（留空 = 不监听）
#   VOICE_TRIGGER_BAUD=115200          波特率
#   VOICE_TRIGGER_KEYWORD=WAKE         关键字
#   VOICE_TRIGGER_GPIO=                监听 GPIO 编号（留空 = 不监听）
#   VOICE_TRIGGER_GPIO_ACTIVE=1        触发电平（1=高，0=低）
#   VOICE_TRIGGER_DEBOUNCE=3000        防抖毫秒
#   VOICE_TRIGGER_ASK_SECS=15          触发后录多少秒
#   VOICE_TRIGGER_VERBOSE=0            1 = 打印原始串口数据
#
# ⚠️ 不要把 nofile 收紧（比如 limits nofile="64 64"）：
#    procd.sh 用 fd 1000 做 flock，子进程继承 64 上限就开不出来 →
#    所有 init 脚本的 restart 都会失败且返回 1。

START=97
STOP=10
USE_PROCD=1

CONF=/etc/voice.conf
VOICE_BIN=/usr/bin/voice

start_service() {
    local uart gpio baud kw active debounce ask verbose

    # 读配置（voice.conf 是 shell 片段，直接 source）
    [ -f "$CONF" ] && . "$CONF"

    uart="${VOICE_TRIGGER_UART:-}"
    baud="${VOICE_TRIGGER_BAUD:-115200}"
    kw="${VOICE_TRIGGER_KEYWORD:-WAKE}"
    gpio="${VOICE_TRIGGER_GPIO:-}"
    active="${VOICE_TRIGGER_GPIO_ACTIVE:-1}"
    debounce="${VOICE_TRIGGER_DEBOUNCE:-3000}"
    ask="${VOICE_TRIGGER_ASK_SECS:-15}"
    verbose="${VOICE_TRIGGER_VERBOSE:-0}"

    # 两个触发源都没配 → 不启动（避免空跑）
    if [ -z "$uart" ] && [ -z "$gpio" ]; then
        logger -t voice-trigger "未配置触发源（VOICE_TRIGGER_UART/GPIO），跳过"
        echo "voice-trigger: 未配置触发源，跳过"
        return 0
    fi

    if [ ! -x "$VOICE_BIN" ]; then
        logger -t voice-trigger "$VOICE_BIN 不存在，跳过"
        return 0
    fi

    # 组装参数
    set -- trigger
    [ -n "$uart" ] && set -- "$@" -u "$uart" -b "$baud" -k "$kw"
    [ -n "$gpio" ] && set -- "$@" -g "$gpio" -a "$active"
    set -- "$@" -d "$debounce" -s "$ask"
    [ "$verbose" = "1" ] && set -- "$@" -v

    procd_open_instance
    procd_set_param command "$VOICE_BIN" "$@"
    procd_set_param respawn              # 崩溃后自动重启
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    logger -t voice-trigger "已启动：$*"
    echo "voice-trigger: 已启动"
}

stop_service() {
    logger -t voice-trigger "已停止"
    return 0
}

service_triggers() {
    # 配置文件变了就重启实例
    procd_add_reload_trigger voice
}
